{
  "manifest_version": 3,
  "name": "Helium Void",
  "version": "1.4",
  "description": "Pure black AMOLED frame with neutral system-dark grays. Minimal and easy on the eyes.",
  "theme": {
    "colors": {
      "frame":                                   [  0,   0,   0],
      "frame_inactive":                          [  0,   0,   0],
      "frame_incognito":                         [  0,   0,   0],
      "frame_incognito_inactive":                [  0,   0,   0],

      "toolbar":                                 [  7,   7,   7],
      "toolbar_text":                            [255, 255, 255],
      "toolbar_button_icon":                     [255, 255, 255],
      "button_background":                       [  0,   0,   0],

      "tab_text":                                [255, 255, 255],
      "background_tab":                          [ 28,  28,  30],
      "background_tab_inactive":                 [ 28,  28,  30],
      "background_tab_incognito":                [ 28,  28,  30],
      "background_tab_incognito_inactive":       [ 28,  28,  30],
      "tab_background_text":                     [255, 255, 255],
      "tab_background_text_inactive":            [255, 255, 255],
      "tab_background_text_incognito":           [255, 255, 255],
      "tab_background_text_incognito_inactive":  [255, 255, 255],

      "bookmark_text":                           [255, 255, 255],

      "omnibox_background":                      [ 28,  28,  30],
      "omnibox_text":                            [255, 255, 255],

      "ntp_background":                          [ 28,  28,  30],
      "ntp_text":                                [255, 255, 255],
      "ntp_link":                                [ 10, 132, 255],
      "ntp_header":                              [242, 242, 247]
    },
    "properties": {
      "ntp_logo_alternate": 1
    }
  }
}
