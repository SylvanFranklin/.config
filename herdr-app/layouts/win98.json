{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "screen",
      "type": "row",
      "children": [
        {
          "id": "desktop",
          "type": "block",
          "content": {
            "mod": "win98",
            "props": {
              "role": "desktop"
            }
          },
          "size": {
            "px": 120.0
          },
          "window_drag": true
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "win98",
                  "props": {
                    "role": "window"
                  }
                },
                "reveal": "always",
                "height": 25.714,
                "position": "top"
              },
              "background": "#000000",
              "border": {
                "width": 4.286,
                "color": "#c0c0c0"
              },
              "focus": {
                "width": 4.286,
                "color": "#c0c0c0"
              },
              "radius": 0.0,
