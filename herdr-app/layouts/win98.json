            }
          },
          "padding": [
            10.0,
            10.0
          ]
        }
      ],
      "resizable": false,
      "floating": [
        {
          "id": "clippy",
          "content": {
            "mod": "win98",
            "props": {
              "role": "clippy"
            }
          },
